{
  "name": "whatsapp-api-gateway",
  "version": "1.0.0",
  "description": "High-speed, self-hosted WhatsApp API Gateway with multi-session, pacing, webhooks, AI, voice ERP queries, and MCP server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "redis": ".\\bin\\redis\\redis-server.exe",
    "demo": "tsx scripts/demo.ts",
    "mcp": "tsx src/mcp/server.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "gateway",
    "api",
    "fastify",
    "bullmq",
    "anti-ban",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/websocket": "^11.0.2",
    "@google/generative-ai": "^0.24.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@whiskeysockets/baileys": "^6.7.13",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "groq-sdk": "^0.15.0",
    "ioredis": "^5.5.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "ret": "^0.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
