# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3001
MCP_GATEWAY_URL=http://127.0.0.1:3000

# Security & Encryption (Survives container restarts)
ENCRYPTION_KEY=whatsapp-super-secret-key-32-chars!
ADMIN_API_KEY=wag_live_admin_secret_key_demo_12345

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_gateway

# Queue / Cache (Redis)
REDIS_URL=redis://localhost:6379

# Free AI & Voice APIs
# Get free Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=
# Get free Groq API key (7,000 free audio sec/day): https://console.groq.com
GROQ_API_KEY=
# Self-hosted Whisper sidecar (in Docker Compose)
WHISPER_URL=http://whisper:8000/v1/audio/transcriptions

# Anti-Ban & Pacing Defaults
TYPING_SPEED_MS_PER_CHAR=45
MIN_DELAY_BETWEEN_MESSAGES_MS=2000
MAX_DELAY_BETWEEN_MESSAGES_MS=5000
MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_DAY=500
WARMUP_MODE_ENABLED=true
