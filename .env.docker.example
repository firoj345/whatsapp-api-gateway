# ==========================================================
# WhatsApp API Gateway - Docker & Cloud Environment Config
# ==========================================================

# Port Configuration
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Public URL of the Backend (used by frontend in browser)
# For local Docker: http://localhost:3000
# For production: https://api.yourdomain.com or https://whatsapp-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Security Keys
# Change ENCRYPTION_KEY to a secure 32+ character random string in production!
ENCRYPTION_KEY=whatsapp-super-secret-key-32-chars!
ADMIN_API_KEY=wag_live_admin_secret_key_demo_12345

# Database Configuration (PostgreSQL)
# For local Docker:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_gateway
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/whatsapp_gateway

# For Cloud Free Tier (e.g. Supabase, Neon):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Redis Configuration (BullMQ Message Queues & Anti-Ban Pacing)
# For local Docker:
REDIS_URL=redis://redis:6379

# For Cloud Free Tier (e.g. Upstash):
# REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379

# AI & Multimodal LLM Providers (Free Tier APIs)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Safety & Anti-Ban Pacing Settings
TYPING_SPEED_MS_PER_CHAR=45
MIN_DELAY_BETWEEN_MESSAGES_MS=2000
MAX_DELAY_BETWEEN_MESSAGES_MS=5000
MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_DAY=500
WARMUP_MODE_ENABLED=true
